# Optional: without a key, deterministic processing remains available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set to 1 to force local-only processing, even when a key is configured.
DOCUVERIFY_DISABLE_AI=0

# Optional API service: use a bucket you control and Application Default Credentials.
RESULTS_BUCKET=

# Windows only, when these programs are not available on PATH:
# POPPLER_PATH=C:\path\to\poppler\Library\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
